# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json
# Local bundler install (do not commit)
vendor/
.bundle/

# Portfolio plaintext source + images: encrypted at build time, never committed in cleartext
_portfolio/
images/portfolio/

# Services plaintext source: encrypted at build time, never committed in cleartext
_services/

# macOS folder view metadata — never commit
.DS_Store
